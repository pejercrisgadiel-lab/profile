/* ==========================================
   1. GLOBAL & AMBIENT CRIMSON BACKGROUND
   ========================================== */
body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: #0c0202;
    background-image: 
        radial-gradient(at 0% 0%, rgba(153, 0, 0, 0.35) 0px, transparent 50%),
        radial-gradient(at 100% 0%, rgba(220, 38, 38, 0.25) 0px, transparent 50%),
        radial-gradient(at 50% 100%, rgba(112, 2, 2, 0.3) 0px, transparent 50%),
        repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.015) 0, rgba(255, 255, 255, 0.015) 10px, transparent 10px, transparent 20px);
    background-attachment: fixed;
    color: #f1f5f9;
    min-height: 100vh;
}

h1, h2, h3, h4, h5, h6, .navbar-brand {
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: -0.02em;
}

.hero-gradient-text {
    background: linear-gradient(135deg, #ffffff 30%, #fca5a5 70%, #ef4444 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* ==========================================
   2. NAVBAR & BRANDING
   ========================================== */
.custom-navbar {
    background-color: #171b22 !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 10px !important;
    padding: 10px 16px !important;
}

.custom-navbar .navbar-brand {
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff !important;
    letter-spacing: -0.01em;
}

/* Rounded square logo frame that crops white corner spots */
.custom-navbar .logo-box {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    overflow: hidden;
    background-color: #0c0d10;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.custom-navbar .logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.22);
}

.custom-navbar .navbar-toggler {
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    border-radius: 8px;
    padding: 6px 10px;
}

.custom-navbar .navbar-toggler-icon {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 0.75%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
}

.nav-link.active {
    color: #ef4444 !important;
    font-weight: 700;
}

/* ==========================================
   3. HERO BANNER & CARDS
   ========================================== */
.ue-red-hero {
    position: relative;
    background: 
        linear-gradient(135deg, #600000 0%, #990000 40%, #b91c1c 80%, #450000 100%),
        repeating-linear-gradient(-45deg, rgba(0, 0, 0, 0.2) 0, rgba(0, 0, 0, 0.2) 12px, transparent 12px, transparent 24px);
    background-blend-mode: overlay;
    border-radius: 20px;
    padding: 35px;
    color: #ffffff;
    box-shadow: 0 20px 50px rgba(153, 0, 0, 0.4), inset 0 0 80px rgba(0,0,0,0.4);
    border: 1px solid rgba(255, 255, 255, 0.18);
    overflow: hidden;
}

.ue-featured-frame {
    border-radius: 16px;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.25);
    background-color: #000;
}

.ue-featured-frame img {
    width: 100%;
    height: 310px;
    object-fit: cover;
}

.ue-card {
    background: rgba(26, 8, 8, 0.85);
    border-radius: 20px;
    border: 1px solid rgba(220, 38, 38, 0.25);
    height: 100%;
    position: relative;
    overflow: hidden;
}

.icon-box {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background-color: rgba(220, 38, 38, 0.2);
    color: #ef4444;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
}

.img-showcase-card {
    background: rgba(26, 8, 8, 0.85);
    border-radius: 20px;
    border: 1px solid rgba(220, 38, 38, 0.25);
    overflow: hidden;
}

.img-container {
    height: 250px;
}

.img-showcase-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.cta-card {
    background: linear-gradient(135deg, #450000 0%, #800000 50%, #1a0000 100%);
    border-radius: 24px;
    border: 1px solid rgba(239, 68, 68, 0.3);
}